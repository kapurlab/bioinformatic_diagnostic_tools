#!/usr/bin/env bash
# Consolidated Diagnostic Tools dashboard — OOD batch_connect session script.
# Runs on the allocated compute node. $port is exported by before.sh.
#
# It starts ONE authenticated dashboard (bin/ood_dashboard). The dashboard
# launches each tool the user opens as a uvicorn bound to 127.0.0.1 on THIS node
# and reverse-proxies to it, so:
#   * one Slurm allocation serves the whole session (not one job per tool), and
#   * auth is enforced once here (per-session token + OOD username match),
#     so no other user can reach the session.

echo "=== Bioinformatic Diagnostic Tools (bdtools) — session starting ==="
echo "host:$(hostname)  dashboard-port:${port}"

# ---- this deployment's shared tools root, if it has one ----
# install-server.sh rewrites the path below to the site's TOOLS_ROOT
# (bin/install-server.sh:subst), which is why the reference value is written out
# literally: subst matches on it. A per-user or sandbox install never runs
# subst, so on those machines this line arrives holding the reference site's
# path — another institution's filesystem, not a fallback.
#
# So it is used only if it exists HERE, and otherwise replaced by whatever this
# machine says. Everything downstream then derives from one variable instead of
# repeating the literal: the python search below used to glob
# /srv/kapurlab/tools/*/env/bin/python on every deployment in the world, which
# found nothing and told nobody, and put a foreign path in front of anyone
# reading the session log.
SITE_TOOLS_ROOT=/srv/kapurlab/tools
[ -d "${SITE_TOOLS_ROOT}" ] || SITE_TOOLS_ROOT="${BDTOOLS_TOOLS_ROOT:-${BDTOOLS_TOOLSDIR:-}}"

# ---- locate the umbrella checkout (shared install, else per-user) ----
SHARED_REPO=""
[ -n "${SITE_TOOLS_ROOT}" ] && SHARED_REPO="${SITE_TOOLS_ROOT}/bioinformatic_diagnostic_tools"
PERSONAL_REPO="${BDTOOLS_REPO:-${HOME}/bioinformatic_diagnostic_tools}"
if [ -n "${SHARED_REPO}" ] && [ -d "${SHARED_REPO}/bin/ood_dashboard" ]; then
  REPO="${SHARED_REPO}"
  export BDTOOLS_TOOLSDIR="${SITE_TOOLS_ROOT}"
elif [ -d "${PERSONAL_REPO}/bin/ood_dashboard" ]; then
  REPO="${PERSONAL_REPO}"
else
  echo "ERROR: cannot find the bioinformatic_diagnostic_tools checkout (looked in" >&2
  echo "       ${SHARED_REPO:-<no shared tools root configured>} and ${PERSONAL_REPO})." >&2
  echo "       Set BDTOOLS_REPO to the checkout, or install it at ${PERSONAL_REPO}." >&2
  exit 1
fi
echo "  umbrella: ${REPO}"

# ---- authentication material (both injected here so they always match) ----
# $password is the per-session secret the OOD "basic" template generates; the
# view page hands it to the browser once as ?t=... and the dashboard turns it
# into a cookie. $USER is the OOD-authenticated user; the dashboard rejects any
# request whose (unspoofable) X-Forwarded-User header doesn't match it.
#
# Read as a SHELL variable, never by ERB interpolation. OOD 4 dropped `password`
# from the script template's binding (BatchConnect::Session::TemplateBinding), so
# an ERB tag naming it fails the stage step outright. The basic template sets it in
# the shell that runs this script, exactly like $port from before.sh — which this
# file already reads that way — so the shell form works on 3.x and 4.x alike.
# Do not write an ERB tag for it even inside a comment: ERB evaluates the whole
# file, so a commented-out tag raises exactly the same NameError.
export BDTOOLS_SESSION_TOKEN="${password}"
export BDTOOLS_SESSION_OWNER="${USER}"

# ---- session resource intent (the card's CPU/memory fields) ----
# On a Slurm cluster these numbers became the allocation via submit.yml.erb;
# on a linux_host server nothing enforces them, so hand them to the tools:
# every tool launched in this session inherits this environment
# (tool_launch.py starts backends from os.environ) and sizes its thread
# counts to BDTOOLS_SESSION_CORES instead of grabbing every core on a shared
# box. Form attributes are bare ERB locals (see the submit.yml.erb note);
# defined?() keeps a card whose form dropped the field from failing to stage.
export BDTOOLS_SESSION_CORES="<%= defined?(num_cores) ? num_cores.to_i : 0 %>"
export BDTOOLS_SESSION_MEM_GB="<%= defined?(mem_gb) ? mem_gb.to_i : 0 %>"
echo "  session budget: ${BDTOOLS_SESSION_CORES} cores, ${BDTOOLS_SESSION_MEM_GB} GB (tools cap their threads to this)"

# ---- find a python with the dashboard's deps (starlette + httpx + uvicorn) ----
# These live in every tool's conda env; pick the first that imports them.
# Candidates are built from what this machine actually has: the site tools root
# when one was resolved above, then the per-user checkouts the local installer
# builds envs in (<checkout>/env — missed before, so a per-user install with no
# miniforge base had no candidate at all), then a personal conda base.
PYTHON=""
BD_CHECKOUTS="${BDTOOLS_HOME:-${XDG_DATA_HOME:-${HOME}/.local/share}/bdtools}/checkouts"
CANDS=()
if [ -n "${SITE_TOOLS_ROOT}" ]; then
  CANDS+=( "${SITE_TOOLS_ROOT}"/*/env/bin/python "${SITE_TOOLS_ROOT}"/vsnp3/bin/python )
fi
# <checkout>/env is where install-local.sh builds a per-user env, and it was not
# searched at all: a personal install with no miniforge base had no candidate
# here and the session died with "no python with starlette+httpx+uvicorn found"
# while every tool it lists had one.
CANDS+=( "${BD_CHECKOUTS}"/*/env/bin/python )
for base in "${HOME}/miniforge3" "${HOME}/miniconda3" "${HOME}/mambaforge" "${HOME}/anaconda3"; do
  CANDS+=( "${base}"/envs/*/bin/python "${base}/bin/python" )
done
for cand in "${CANDS[@]}"; do
  [ -x "${cand}" ] || continue
  if "${cand}" -c 'import starlette, httpx, uvicorn' >/dev/null 2>&1; then
    PYTHON="${cand}"; break
  fi
done
if [ -z "${PYTHON}" ]; then
  echo "ERROR: no python with starlette+httpx+uvicorn found. Install any tool" >&2
  echo "       (its conda env ships these) or add them to a base env." >&2
  exit 1
fi
echo "  python:   ${PYTHON}"

cd "${REPO}/bin/ood_dashboard"
echo "Starting dashboard on 0.0.0.0:${port}"
exec "${PYTHON}" -m uvicorn app:app \
    --host 0.0.0.0 \
    --port "${port}" \
    --log-level info
