# per-site config (copy sites/site.conf.example -> sites/site.conf)
sites/site.conf
sites/*.conf
!sites/site.conf.example

# local tool checkouts, if a user points BDTOOLS_HOME inside the repo
checkouts/

# optional one-line source root for local feature-worktree dashboard testing
.bdtools-tools-dir

# editor / OS noise
*.swp
.DS_Store
__pycache__/
*.pyc

# Session handoffs and the agent working notes under .claude/ are TRACKED: the
# development record and the new-tool layout checklist are more useful to the
# next contributor than they are risky, and keeping them local meant every
# machine had a different copy. Review a handoff before committing it — no
# credentials, keys, tokens or host addresses.
#
# Machine-local agent state stays ignored.
.claude/settings.local.json
.claude/*.local.md
