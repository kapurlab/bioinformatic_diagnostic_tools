{
  "contract": 1,
  "id": "__ADDON_ID__",
  "tool": "__ADDON_TOOL__",
  "name": "__ADDON_NAME__",
  "version": "0.1.0",
  "consumer": "vsnp_gui",
  "description": "__ADDON_NAME__ add-on for vsnp_gui: per-sample reference choice, a Results row and report per sample, and a run report.",
  "env": "__ADDON_TOOL__",
