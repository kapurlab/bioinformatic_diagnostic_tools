# per-site config (copy sites/site.conf.example -> sites/site.conf)
sites/site.conf
sites/*.conf
!sites/site.conf.example

# local tool checkouts, if a user points BDTOOLS_HOME inside the repo
checkouts/

# optional one-line source root for local feature-worktree dashboard testing
.bdtools-tools-dir

# editor / OS noise
*.swp
.DS_Store
__pycache__/
*.pyc
.pytest_cache/

# Local working notes: install runbooks and per-session development records.
# Kept on the machine that produced them rather than published — they name
# in-progress state, machine detail and accounts. The stable, shareable
# documentation is README.md, INSTALL.md and docs/.
AGENTS.md
HANDOFF.md
docs/HANDOFF_*.md
