# per-site config (copy sites/site.conf.example -> sites/site.conf)
sites/site.conf
sites/*.conf
!sites/site.conf.example

# local tool checkouts, if a user points BDTOOLS_HOME inside the repo
checkouts/

# optional one-line source root for local feature-worktree dashboard testing
.bdtools-tools-dir

# editor / OS noise
*.swp
.DS_Store
__pycache__/
*.pyc

# internal dev handoff / session notes — never publish
HANDOFF*.md
*_HANDOFF.md

# local agent working notes (.claude/NEW_TOOL_LAYOUT.md etc). The shareable
# contract lives in docs/BUILDING_A_TOOL.md; these carry in-progress state and
# per-machine detail that would go stale in a release.
.claude/
