#!/usr/bin/env bash
# bdtools — the Kapur Lab tool-suite manager.
#
# One entry point to install, run, and update the lab's bioinformatics GUIs
# across environments. Reads the suite manifest (tools.yml) and dispatches to
# the install-*.sh helpers.
#
#   bdtools list                       show the tools in the manifest
#   bdtools status                      show what is installed vs. the manifest
#   bdtools install <tool|all> [opts]   install a tool (default mode: --local)
#   bdtools local   <tool> [--port N]   run a locally-installed tool (standalone)
#   bdtools dashboard [--port N]         local landing page: pick + launch a GUI
#                     [--restart|--stop] restart (after a pull) or stop it + tools
#   bdtools make-launcher [--dest DIR]   double-clickable desktop launcher (icon,
#                                        no terminal window) for the dashboard
#   bdtools versions [tool ...]          show the analysis package versions in use
#   bdtools check-updates [tool|all]    report newer upstream versions
#   bdtools update-packages <tool|all>  move a tool's analysis packages (vsnp3,
#                                       AMRFinderPlus, …) to the newest release
#   bdtools update  <tool|all> [opts]   move a tool to its latest version
#   bdtools site-init [opts]            one-time bare-metal site bootstrap
#   bdtools setup-databases [opts]      download shared reference DBs + wire the GUIs
#   bdtools doctor  [tool ...]          check installs are runnable; print fixes
#   bdtools lint    [tool ...]          (maintainer) flag dependency drift in repos
#   bdtools test    <tool|all> [opts]   validate a deployment on a known sample
#
# Install modes (pass to `install`):
#   --local      standalone: conda env + uvicorn + browser (Linux/macOS/WSL2). DEFAULT.
#   --sandbox    per-user OOD sandbox app in ~/ondemand/dev   (institutional OOD)
#   --server     system OOD app install                       (sysadmin / bare-metal)
#
# By default --server installs ONLY the production card a normal user sees.
#   --with-dev   (server only) ALSO install the developer branch-picker card(s).
#                Developers only — keep off for routine diagnostic sites.
#
# Common options: --prefix DIR, --site-conf PATH (server/site-init), --dry-run, -h|--help
set -euo pipefail

# Resolve this script's real path, following symlinks, so `bdtools` can be
# symlinked (into the repo root, onto $PATH, ~/bin, …) and still find its libs.
# Portable for bash 3.2 (macOS) — no `readlink -f`. Handles relative/absolute
# targets and symlink chains.
_bdt_src="${BASH_SOURCE[0]}"
while [[ -h "${_bdt_src}" ]]; do
  _bdt_dir="$(cd -P "$(dirname "${_bdt_src}")" && pwd)"
  _bdt_src="$(readlink "${_bdt_src}")"
  [[ "${_bdt_src}" != /* ]] && _bdt_src="${_bdt_dir}/${_bdt_src}"
done
_bdt_dir="$(cd -P "$(dirname "${_bdt_src}")" && pwd)"
source "${_bdt_dir}/lib/common.sh"

usage() { sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; }

cmd_list() {
  printf '%-22s %-26s %s\n' "TOOL" "VERSION (pinned)" "OOD APP(S)"
  while read -r name; do
    [[ -n "$name" ]] || continue
    printf '%-22s %-26s %s\n' "$name" "$(manifest_get "$name" version)" "$(manifest_get "$name" ood_apps)"
  done < <(manifest_names)
  echo
  echo "suite_version: $(manifest_suite_version)   manifest: ${MANIFEST}"
}

cmd_status() {
  printf '%-22s %-18s %-18s %s\n' "TOOL" "PINNED" "INSTALLED" "CHECKOUT"
  while read -r name; do
    [[ -n "$name" ]] || continue
    local dir installed="(not installed)"
    dir="$(tool_dir "$name")"
    if [[ -d "${dir}/.git" ]]; then
      installed="$(git -C "$dir" describe --tags --always 2>/dev/null || echo '?')"
    fi
    printf '%-22s %-18s %-18s %s\n' "$name" "$(manifest_get "$name" version)" "$installed" "$dir"
  done < <(manifest_names)
}

cmd_install() {
  local mode="local"; local raw=() passthru=() with_dev=0 no_dashboard=0 dashboard=0 site_conf=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local)   mode="local";   shift;;
      --sandbox) mode="sandbox"; shift;;
      --server)  mode="server";  shift;;
      --dry-run)   DRY_RUN=1; export DRY_RUN; passthru+=(--dry-run); shift;;
      --prefix)    export BDTOOLS_HOME="$2"; passthru+=(--prefix "$2"); shift 2;;
      --site-conf) site_conf="$2"; passthru+=(--site-conf "$2"); shift 2;;
      --with-dev)  with_dev=1; shift;;
      --no-card)   passthru+=(--no-card); shift;;   # server: build a tool's env but skip its per-tool card
      --dashboard) dashboard=1; shift;;             # server: install the consolidated dashboard card
      --no-dashboard) no_dashboard=1; shift;;   # local: don't auto-open the dashboard at the end
      -h|--help)   cat <<'EOF'
usage: bdtools install [--local|--sandbox|--server] <tool|all> [options]

  --local     (default) personal install on this machine; tools served at
              127.0.0.1 via `bdtools dashboard`. No Open OnDemand involved.
  --sandbox   per-user Open OnDemand app in ~/ondemand/dev/. No admin rights
              needed, but the Develop menu usually must be enabled for you.
  --server    system-wide Open OnDemand install (needs root).

Options:
  --dry-run          print every action, change nothing. Use this first.
  --site-conf PATH   site configuration (--server); default sites/site.conf
  --prefix DIR       install root instead of ~/.local/share/bdtools
  --no-card          --server: build the environment, register no per-tool card
  --dashboard        --server: register the single consolidated dashboard card
  --with-dev         --server: also register developer branch-picker cards
  --no-dashboard     --local: don't open the dashboard when finished

`all` means every tool in tools.yml. Examples:

  bdtools install all                        # personal install of the whole suite
  bdtools install --sandbox all              # per-user OOD apps
  bdtools install all --server --no-card     # build envs site-wide, no cards
  bdtools install --server --dashboard       # register the one OOD card

Open OnDemand deployments: see docs/INSTALL_HPC_OOD.md.
EOF
                   return 0;;
      -*)          die "install: unknown option '$1'  (see: bdtools install --help)";;
      *)         raw+=("$1"); shift;;
    esac
  done
  # --dashboard installs the single umbrella-owned card (no tool positional).
  if [[ ${dashboard} -eq 1 ]]; then
    [[ "${mode}" == "server" ]] || die "--dashboard only applies to --server installs"
    local dargs=(); [[ ${DRY_RUN:-0} -eq 1 ]] && dargs+=(--dry-run)
    [[ -n "${site_conf}" ]] && dargs+=(--site-conf "${site_conf}")
    exec "${KT_BIN_DIR}/install-server.sh" --dashboard ${dargs[@]+"${dargs[@]}"}
  fi
  # --with-dev is a server-only opt-in (developer branch-picker cards).
  if [[ ${with_dev} -eq 1 ]]; then
    [[ "${mode}" == "server" ]] || die "--with-dev only applies to --server installs"
    passthru+=(--with-dev)
  fi
  [[ ${#raw[@]} -gt 0 ]] || die "install: name a tool or 'all' (see: bdtools list)"
  local targets=() r n
  for r in "${raw[@]}"; do
    if [[ "$r" == all ]]; then
      while read -r n; do [[ -n "$n" ]] && targets+=("$n"); done < <(manifest_names)
    else
      manifest_has "$r" || die "unknown tool: $r (see: bdtools list)"
      targets+=("$r")
    fi
  done
  local script="${KT_BIN_DIR}/install-${mode}.sh"
  [[ -x "$script" ]] || die "no installer for mode '${mode}' (${script})"
  # install = build only (never auto-launch); `bdtools local <tool>` launches.
  [[ "${mode}" == "local" ]] && passthru+=(--build-only)
  local rc=0 skipped=()
  for t in "${targets[@]}"; do
    if "$script" "$t" ${passthru[@]+"${passthru[@]}"}; then :; else
      local ec=$?
      if [[ ${ec} -eq 3 ]]; then skipped+=("$t");   # no local-build path (OOD-only) — not a failure
      else warn "install failed: ${t}"; rc=1; fi
    fi
  done
  if [[ ${#skipped[@]} -gt 0 ]]; then
    warn "skipped (no local install — OOD-only): ${skipped[*]}"
  fi

  # Local installs: tell the user their access point, then open the dashboard.
  if [[ "${mode}" == "local" && ${rc} -eq 0 && ${DRY_RUN:-0} -eq 0 ]]; then
    # Example tool = first target that actually installed locally (skip OOD-only).
    local first="" t2
    for t2 in "${targets[@]}"; do
      [[ " ${skipped[*]-} " == *" ${t2} "* ]] || { first="${t2}"; break; }
    done
    [[ -n "${first}" ]] || first="mlst_gui"
    echo
    ok "Install complete."
    cat <<EOF

  Your tools are here:   ${REPO_DIR}

  The dashboard opens in your browser now. Pick a tool and it opens in a tab.
  Keep the dashboard window open while you work.

  To open the dashboard again later (e.g. after restarting your computer):
      • macOS: double-click  "Open Dashboard.command"  in the folder above
      • or run:  bin/bdtools dashboard      (then open http://127.0.0.1:8080/)

  Launch a single tool instead:
      bin/bdtools local ${first} --port 8080      # then open http://127.0.0.1:8080/

  Validate against known samples (optional):
      bin/bdtools test all
EOF
    # Offer to set up the shared reference databases (Kraken2, BLAST, vSNP
    # references). They're large and third-party, so they're fetched on demand
    # rather than bundled. Only the tools that need them benefit, but the prompt
    # is cheap and the alternative (a tool failing for a missing DB) is worse.
    if [[ -t 0 && -t 1 ]]; then
      echo
      read -r -p "Set up reference databases now (Kraken2, BLAST, vSNP)? [y/N]: " want_db
      if [[ "${want_db}" =~ ^[Yy] ]]; then
        "${KT_BIN_DIR}/setup-databases.sh" || warn "database setup did not complete — re-run later with 'bin/bdtools setup-databases'"
      else
        info "Skipped. Set them up anytime with:  bin/bdtools setup-databases"
      fi
    else
      # Non-interactive (bdtools invoked as a subprocess, so stdin isn't a TTY
      # and we can't prompt). Don't silently skip — make the next step explicit
      # so it's surfaced in the caller's output and acted on.
      echo
      warn "Reference databases (Kraken2, BLAST, vSNP) are NOT set up yet — some tools need them."
      info "  ACTION: run  bin/bdtools setup-databases   (asks Home vs Shared), or pass --home / --shared."
    fi
    # Readiness summary: confirm each install can actually run, with fixes for
    # anything missing (a dependency or an un-set-up database). Non-fatal.
    echo; info "checking your installs are ready to run…"
    local doctor_json; doctor_json="$("${KT_BIN_DIR}/doctor.sh" --json 2>/dev/null || true)"
    "${KT_BIN_DIR}/doctor.sh" || true     # human-readable summary
    # Offer to refresh any env with a fixable gap (a missing dependency the spec
    # now declares). Platform limitations (e.g. bracken on macOS) are reported as
    # notes, not issues, so they don't trigger a rebuild that can't help.
    local need_rebuild
    need_rebuild="$(printf '%s' "${doctor_json}" | "${PYBIN}" -c '
import sys, json
try: data = json.load(sys.stdin)
except Exception: data = []
print(" ".join(sorted({t["tool"] for t in data
      for i in t.get("issues", []) if "bdtools update" in i.get("fix", "")})))' 2>/dev/null || true)"
    if [[ -n "${need_rebuild}" ]]; then
      if [[ -t 0 && -t 1 ]]; then
        echo; read -r -p "Rebuild the environment for: ${need_rebuild}? [Y/n]: " ans
        if [[ ! "${ans}" =~ ^[Nn] ]]; then
          local rt
          for rt in ${need_rebuild}; do
            "${KT_BIN_DIR}/install-local.sh" --build-only --rebuild "${rt}" || warn "rebuild of ${rt} did not complete"
          done
          echo; info "re-checking…"; "${KT_BIN_DIR}/doctor.sh" || true
        fi
      else
        echo
        warn "These tools need their environment refreshed: ${need_rebuild}"
        info "  ACTION: run  bin/bdtools update <tool>  for each (refreshes the env from its spec)."
      fi
    fi
    if [[ ${no_dashboard} -eq 0 && -t 1 ]]; then
      echo; info "opening the dashboard (Ctrl-C to stop; re-open later with 'bin/bdtools dashboard')…"
      cmd_dashboard
    fi
  fi
  return $rc
}

cmd_local() {
  [[ $# -ge 1 ]] || die "usage: bdtools local <tool> [--port N] [--no-browser]"
  manifest_has "$1" || die "unknown tool: $1"
  # build-if-needed, then launch (the build steps are idempotent). Forward the
  # rest of the args (--port, --no-browser, ...) to the launcher.
  "${KT_BIN_DIR}/install-local.sh" --run-only "$@"
}

# Pick a python that can run the reverse-proxy dashboard (needs starlette+httpx+
# uvicorn — present in every tool's conda env). Prints its path, or nothing.
#
# The candidate list MUST agree with tool_launch.py:_conda_bases(): that helper
# probes CONDA_BASE/CONDA_EXE and ~/miniconda3, ~/mambaforge, ~/anaconda3, /opt/…
# — not just ~/miniforge3. If this selector searched fewer places than the
# launcher, a box whose only proxy-capable env lives in (say) a group
# /…/miniconda3/envs/<tool> would silently fall back to the legacy multi-port
# dashboard even though the launcher could happily run every tool from it.
_dashboard_proxy_python() {
  local cand b

  # Explicit override always wins (set BDTOOLS_DASHBOARD_PYTHON=/path/to/python).
  if [[ -n "${BDTOOLS_DASHBOARD_PYTHON:-}" && -x "${BDTOOLS_DASHBOARD_PYTHON}" ]] \
     && "${BDTOOLS_DASHBOARD_PYTHON}" -c 'import starlette, httpx, uvicorn' >/dev/null 2>&1; then
    echo "${BDTOOLS_DASHBOARD_PYTHON}"; return 0
  fi

  # Conda bases to probe, mirroring tool_launch.py:_conda_bases() (order = priority).
  local bases=()
  [[ -n "${CONDA_BASE:-}" ]] && bases+=("${CONDA_BASE}")
  [[ -n "${CONDA_EXE:-}"  ]] && bases+=("$(dirname "$(dirname "${CONDA_EXE}")")")
  local condabin; condabin="$(command -v conda 2>/dev/null || true)"
  [[ -n "${condabin}" ]] && bases+=("$(dirname "$(dirname "${condabin}")")")
  [[ -n "${CONDA_PREFIX:-}" ]] && bases+=("${CONDA_PREFIX}")  # the active env itself
  bases+=("${HOME}/miniforge3" "${HOME}/miniconda3" "${HOME}/mambaforge" \
          "${HOME}/anaconda3" /opt/miniforge3 /opt/miniconda3)

  # Tool checkouts first (own <dir>/env), then every conda base's envs + base
  # python. The checkout roots are RESOLVED, never literal: an explicit
  # BDTOOLS_TOOLSDIR, this checkout's own parent (a site tree like
  # <root>/tools/bioinformatic_diagnostic_tools has its siblings there), and the
  # managed per-user root. A baked-in "/srv/kapurlab/tools" here was the last
  # site path left in the CLI and it is correct on exactly one machine —
  # elsewhere it silently contributed nothing.
  local roots=()
  [[ -n "${BDTOOLS_TOOLSDIR:-}" ]] && roots+=("${BDTOOLS_TOOLSDIR}")
  roots+=("$(dirname "${REPO_DIR}")" "${BDTOOLS_HOME}/checkouts")
  local root
  for root in "${roots[@]}"; do
    [[ -d "${root}" ]] || continue
    for cand in "${root}"/*/env/bin/python; do
      [[ -x "${cand}" ]] || continue
      if "${cand}" -c 'import starlette, httpx, uvicorn' >/dev/null 2>&1; then
        echo "${cand}"; return 0
      fi
    done
  done
  for b in "${bases[@]}"; do
    for cand in "${b}"/envs/*/bin/python "${b}"/bin/python; do
      [[ -x "${cand}" ]] || continue
      if "${cand}" -c 'import starlette, httpx, uvicorn' >/dev/null 2>&1; then
        echo "${cand}"; return 0
      fi
    done
  done
  return 1
}

# Should the local dashboard require a one-time session token? Personal machines
# (your own Mac / a WSL box) don't need one — loopback is yours alone. A shared
# multi-user server does: other accounts share 127.0.0.1. Override: set
# BDTOOLS_DASHBOARD_AUTH=1 (force on) or =0 (force off).
_dashboard_wants_token() {
  case "${BDTOOLS_DASHBOARD_AUTH:-}" in
    1|true|yes|on)  return 0;;
    0|false|no|off) return 1;;
  esac
  [[ "$(uname -s)" == "Darwin" ]] && return 1                      # macOS desktop
  [[ -n "${WSL_DISTRO_NAME:-}" ]] && return 1                      # WSL2
  grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null && return 1  # older WSL
  return 0                                                          # assume shared server
}

# Is PORT actually bindable on loopback? Tested by BINDING, not by connecting.
# connect_ex only notices a socket that is LISTENING, so it misses a port that is
# bound-but-not-listening — and that still makes uvicorn die with
# "[Errno 48] address already in use" after we have told the user the dashboard is
# ready.
#
# SO_REUSEADDR is set because uvicorn sets it (uvicorn.config.Config.bind_socket),
# and this test is only useful insofar as it agrees with uvicorn's real bind.
# Without it the test is STRICTER than the thing it predicts: a socket left in
# TIME_WAIT — which is the normal state for a few seconds after stopping a
# dashboard — fails a plain bind while uvicorn would succeed. That made
# `--stop` immediately followed by a start report a busy port on a free one,
# turning a fix for a confusing error into a confusing error of its own.
# SO_REUSEADDR does NOT permit binding over a LIVE listener (that needs
# SO_REUSEPORT), so a genuinely running server is still detected.
_dashboard_port_free() {
  "${PYBIN}" - "$1" <<'PY'
import socket, sys
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(1)
finally:
    s.close()
sys.exit(0)
PY
}

# Wait up to $2 seconds for PORT to become bindable. Returns 0 as soon as it is.
#
# A dashboard shuts down asynchronously: /api/shutdown flushes its HTTP response,
# stops the child tool servers, then exits, so for well under a second after
# `--stop` returns "requested safely" the old process still holds the listening
# socket. Without this grace period the obvious sequence
#   bin/bdtools dashboard --stop && bin/bdtools dashboard
# loses a race with the process it just stopped and reports a busy port — telling
# the user to go stop the dashboard they have already stopped.
_dashboard_wait_port_free() {
  local port="$1" deadline=$(( SECONDS + ${2:-5} ))
  while :; do
    _dashboard_port_free "${port}" && return 0
    (( SECONDS >= deadline )) && return 1
    sleep 0.25
  done
}

# Best-effort "who is holding this port", for the error message. Never fails the
# caller: lsof may be absent or restricted, and a vaguer message still beats a
# bare errno.
_dashboard_port_owner() {
  command -v lsof >/dev/null 2>&1 || return 0
  lsof -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | awk 'NR==2 {print $1" (pid "$2")"}'
}

# Does the state file describe a LIVE dashboard? Echoes "<pid> <port>" if so.
# A stale record (process gone) is treated as absent — dashboard_control.py
# already unlinks those.
_dashboard_recorded() {
  [[ -f "${BDTOOLS_DASHBOARD_STATE_FILE:-}" ]] || return 1
  "${PYBIN}" - "${BDTOOLS_DASHBOARD_STATE_FILE}" <<'PY'
import json, os, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        st = json.load(fh)
    pid, port = int(st["pid"]), int(st["port"])
except Exception:
    sys.exit(1)
try:
    os.kill(pid, 0)
except OSError:
    sys.exit(1)
print(pid, port)
PY
}

# The URL of the ALREADY-RUNNING dashboard, session key included, or nothing.
#
# Needed because "it is already running" is only actionable if you can be taken
# there. From a terminal the printed URL was enough; from a desktop launcher there
# is no terminal to read, so a second double-click looked like it did nothing.
_dashboard_recorded_url() {
  [[ -f "${BDTOOLS_DASHBOARD_STATE_FILE:-}" ]] || return 1
  "${PYBIN}" - "${BDTOOLS_DASHBOARD_STATE_FILE}" <<'PY'
import json, os, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        st = json.load(fh)
    pid, port = int(st["pid"]), int(st["port"])
    os.kill(pid, 0)
except Exception:
    sys.exit(1)
tok = (st.get("session_token") or "").strip()
print(f"http://127.0.0.1:{port}/" + (f"?t={tok}" if tok else ""))
PY
}

cmd_dashboard() {
  # Landing page that lists installed GUIs and launches the one you pick. It
  # prefers the single-port reverse-proxy dashboard (bin/ood_dashboard/app.py):
  # each tool runs on a private loopback port and is served under /t/<tool>/, so
  # only ONE port ever needs to be reachable. Over SSH, forward just that port.
  # Falls back to the legacy per-tool-port dashboard if the proxy deps are absent.
  #   --restart  stop the running dashboard + any tools, then start fresh
  #              (use this after a `git pull` so new code takes effect)
  #   --stop     stop the running dashboard + any tools, and exit
  #   --port N   dashboard port (default 8080)   --no-browser  don't auto-open
  #   --tools-dir DIR  run tool source from DIR/<tool> (feature-worktree testing);
  #                    remembered in .bdtools-tools-dir. `--tools-dir none` forgets it.
  local mode=serve rest=() port=8080 no_browser=0 tools_dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      # Without this, `bdtools dashboard --help` fell through to the catch-all and
      # STARTED the dashboard — asking a command what it does should never launch
      # a server. Prints the option list documented in the comment above.
      -h|--help)    sed -n '/^cmd_dashboard()/,/^  local mode=serve/p' "$0" \
                      | sed -n 's/^  #\{1,\} \{0,1\}/  /p'; return 0;;
      --restart)    mode=restart; shift;;
      --stop)       mode=stop; shift;;
      --no-browser) no_browser=1; rest+=("$1"); shift;;
      --tools-dir=*) tools_dir="${1#--tools-dir=}"; shift;;
      --tools-dir)   [[ $# -ge 2 ]] || die "--tools-dir requires a directory"
                     tools_dir="$2"; shift 2;;
      --port=*)     port="${1#--port=}"; rest+=("$1"); shift;;
      --port)       port="${2:-8080}"; rest+=("$1"); shift
                    if [[ $# -gt 0 ]]; then rest+=("$1"); shift; fi;;
      *)            rest+=("$1"); shift;;
    esac
  done

  # An ignored, checkout-local pointer makes repeated feature testing reliable:
  # once configured, the ordinary `bdtools dashboard` command uses the same
  # source tree every time. An explicit --tools-dir still takes precedence.
  local tools_dir_file="${REPO_DIR}/.bdtools-tools-dir"
  # `--tools-dir none` forgets the pointer, so going back to the released tools
  # doesn't mean knowing to delete an undocumented dotfile.
  case "${tools_dir}" in
    none|off|clear)
      rm -f "${tools_dir_file}"
      ok "cleared the tool-source override — tools now come from ${BDTOOLS_HOME}/checkouts/<tool>"
      tools_dir=""
      ;;
  esac
  if [[ -z "${tools_dir}" && -f "${tools_dir_file}" ]]; then
    IFS= read -r tools_dir < "${tools_dir_file}" || true
  fi

  if [[ -n "${tools_dir}" ]]; then
    [[ -d "${tools_dir}" ]] || die "--tools-dir does not exist: ${tools_dir}"
    BDTOOLS_TOOLSDIR="$(cd "${tools_dir}" && pwd -P)"
    export BDTOOLS_TOOLSDIR
    info "Testing tool source from ${BDTOOLS_TOOLSDIR}"
    # This overrides CODE only. Conda envs and large vendored payloads (kSNP4's
    # 545 MB package) are gitignored, so a worktree has none — they're borrowed
    # from ${BDTOOLS_HOME}/checkouts/<tool>. If a payload is missing from BOTH,
    # tool_launch warns at launch and the tool's card flags it; the analysis would
    # otherwise fail much later with a bare "command not found".
    info "  code only — conda envs and vendored payloads come from the normal install"
    info "  clear this with: bin/bdtools dashboard --tools-dir none"
  fi

  export BDTOOLS_DASHBOARD_STATE_FILE="${BDTOOLS_HOME}/dashboard-state.json"
  export BDTOOLS_DASHBOARD_PORT="${port}"

  if [[ "${mode}" != serve ]]; then
    # Never use broad pkill patterns here: they can orphan detached analyses and
    # can hit an unrelated server owned by the same account. Route the request
    # through the running dashboard, which checks every tool's /api/jobs first.
    local ctl_rc=0 ctl_action="${mode}"
    "${PYBIN}" "${KT_BIN_DIR}/lib/dashboard_control.py" \
      "${BDTOOLS_DASHBOARD_STATE_FILE}" "${ctl_action}" || ctl_rc=$?
    if [[ ${ctl_rc} -eq 0 ]]; then
      ok "dashboard ${mode} requested safely."
      return 0
    fi
    if [[ ${ctl_rc} -eq 2 ]]; then
      warn "dashboard ${mode} was blocked; resolve the active/unverifiable work above."
      return 1
    fi
    if [[ "${mode}" == stop ]]; then
      # "No record" is NOT the same as "nothing is running". A dashboard started
      # in a way that never wrote the state file (or whose record was removed)
      # keeps serving, and reporting success here sent people away believing the
      # port was free — the next `bdtools dashboard` then failed to bind, and the
      # only remaining fix was to hunt the PID by hand. Check the port before
      # claiming anything.
      if _dashboard_port_free "${port}"; then
        info "No running dashboard was recorded, and port ${port} is free — nothing to stop."
        return 0
      fi
      local _owner; _owner="$(_dashboard_port_owner "${port}")"
      warn "No dashboard state record exists, but something is still listening on port ${port}${_owner:+ — ${_owner}}."
      info "  It cannot be stopped safely from here: without the record there is no"
      info "  control token, and killing a PID blind can orphan a running analysis."
      info "  Stop it with whichever applies:"
      info "    • the Shut down button in its browser tab (checks for active analyses first)"
      info "    • Ctrl-C in the terminal that started it"
      local _pid; _pid="$(command -v lsof >/dev/null 2>&1 && lsof -nP -tiTCP:"${port}" -sTCP:LISTEN 2>/dev/null | head -1 || true)"
      if [[ -n "${_pid}" ]]; then
        info "    • kill ${_pid}   — last resort; no active-analysis check"
      else
        info "    • kill the process holding port ${port}   — last resort; no active-analysis check"
      fi
      return 1
    fi
    # No state record: only start a new dashboard if the requested port is free.
    # This protects an older unregistered dashboard from being killed blindly.
    if ! _dashboard_wait_port_free "${port}" 5; then
      local _owner; _owner="$(_dashboard_port_owner "${port}")"
      die "port ${port} is in use${_owner:+ by ${_owner}} but no safe dashboard state record exists.
       Stop it from its browser tab (Shut down) or with Ctrl-C in its terminal,
       then re-run. Or start this one elsewhere: bin/bdtools dashboard --port 8081"
    fi
  fi

  # ---------------------------------------------------------------------------
  # Port pre-flight — runs on EVERY path, including a plain `bdtools dashboard`.
  #
  # This check used to live inside the `mode != serve` block above, so the most
  # common invocation skipped it entirely: the banner printed "Open this in your
  # web browser: http://127.0.0.1:8080/", and only then did uvicorn fail with
  # "ERROR: [Errno 48] error while attempting to bind on address". That reads as
  # "the dashboard started and then broke" when in fact it never started — and
  # the friendly diagnostic three lines up was unreachable. Check first, print
  # the banner second.
  # ---------------------------------------------------------------------------
  if ! _dashboard_wait_port_free "${port}" 5; then
    local _rec _owner
    _rec="$(_dashboard_recorded || true)"
    _owner="$(_dashboard_port_owner "${port}")"
    if [[ -n "${_rec}" && "${_rec##* }" == "${port}" ]]; then
      # Our own dashboard is already up on this port. Wanting "the dashboard" is
      # already satisfied — point at it instead of failing, and (unless asked not
      # to) open it, so a desktop launcher with no visible terminal still lands the
      # user on the page they double-clicked for.
      local _url; _url="$(_dashboard_recorded_url || true)"
      ok "The dashboard is already running on port ${port} (pid ${_rec%% *})."
      info "  Open it:            ${_url:-http://127.0.0.1:${port}/}"
      if [[ ${no_browser} -eq 0 && -n "${_url}" ]]; then
        for o in open xdg-open wslview; do
          command -v "$o" >/dev/null 2>&1 && { "$o" "${_url}" >/dev/null 2>&1; break; }
        done
      fi
      info "  Pick up new code:   bin/bdtools dashboard --restart"
      info "  Stop it:            bin/bdtools dashboard --stop"
      return 0
    fi
    die "port ${port} is already in use${_owner:+ by ${_owner}}, so the dashboard cannot start.
       If that is a bdtools dashboard, stop it from its browser tab (Shut down)
       or with Ctrl-C in its terminal, then re-run. If it is something else,
       start the dashboard on another port:
         bin/bdtools dashboard --port 8081"
  fi

  # Decide which server to run (single-port proxy preferred; legacy fallback),
  # then run it under a restart supervisor below.
  local rundir; local -a runcmd=()
  local pyproxy; pyproxy="$(_dashboard_proxy_python || true)"
  if [[ -n "${pyproxy}" ]]; then
    export BDTOOLS_LOCAL=1
    export BDTOOLS_CONTROL_TOKEN="$("${pyproxy}" -c 'import secrets; print(secrets.token_urlsafe(32))')"
    local want_token=0; _dashboard_wants_token && want_token=1
    local url="http://127.0.0.1:${port}/"
    if [[ ${want_token} -eq 1 ]]; then
      export BDTOOLS_SESSION_TOKEN="$("${pyproxy}" -c 'import secrets; print(secrets.token_urlsafe(24))')"
      url="http://127.0.0.1:${port}/?t=${BDTOOLS_SESSION_TOKEN}"
    fi
    local bar="================================================================"
    printf '\n%s\n  Kapur Laboratory bioinformatic diagnostic tools (bdtools)\n  dashboard starting (single-port proxy).\n\n  Open this in your web browser:\n      %s\n\n' "${bar}" "${url}"
    # Say WHY the URL looks the way it does, in BOTH directions. The same command
    # prints a plain URL on a Mac and a "?t=..." one on a Linux server, and without
    # an explanation that difference reads as a broken install rather than as the
    # platform check it is (see _dashboard_wants_token above).
    if [[ ${want_token} -eq 1 ]]; then
      printf '  The "?t=" on the end is a one-time session key — treat it like a password.\n'
      printf '  This machine looks like a shared server, where other Unix accounts also\n  reach 127.0.0.1, so the key is what stops them opening your dashboard.\n'
      printf '  A personal Mac or WSL box gets a plain URL instead. Override either way\n  with BDTOOLS_DASHBOARD_AUTH=0 (off) or =1 (on).\n\n'
    else
      printf '  No session key is needed on a personal machine — loopback is yours alone.\n'
      printf '  On a shared server the URL ends in "?t=<key>" instead. Force one here with\n  BDTOOLS_DASHBOARD_AUTH=1.\n\n'
    fi
    printf '  Working over SSH? Forward just this one port from your machine:\n      ssh -L %s:127.0.0.1:%s <this-host>\n\n  Keep this window open while you work (Ctrl-C stops everything).\n%s\n\n' "${port}" "${port}" "${bar}"
    if [[ ${no_browser} -eq 0 ]]; then
      ( sleep 1.5
        for o in open xdg-open wslview; do
          command -v "$o" >/dev/null 2>&1 && { "$o" "${url}" >/dev/null 2>&1; break; }
        done ) &
    fi
    rundir="${KT_BIN_DIR}/ood_dashboard"
    runcmd=("${pyproxy}" -m uvicorn app:app --host 127.0.0.1 --port "${port}" --log-level warning)
  else
    # Fallback: proxy deps absent — legacy dashboard (each tool on its own port; over
    # SSH you'd forward each one). Install any tool to pull in starlette/httpx/uvicorn.
    warn "reverse-proxy deps (starlette/httpx/uvicorn) not found — using the legacy dashboard."
    warn "tools will open on their own ports. Install a tool to enable single-port mode."
    # Name the two consequences rather than leaving them to be discovered:
    # different ports means a different browser origin per tool, so the shared
    # appearance choice can't reach them; and this server has no session key.
    info "  Each tool is a separate origin, so your Light/Dark choice is remembered"
    info "  per tool instead of once for the whole suite."
    info "  Over SSH you must forward one port per tool, not just this one."
    _dashboard_wants_token && warn "  This mode has NO session key — other accounts on this host could reach it."
    rundir="${KT_BIN_DIR}"
    runcmd=("${PYBIN}" "${KT_BIN_DIR}/dashboard.py" ${rest[@]+"${rest[@]}"})
  fi

  cd "${rundir}" || die "cannot cd to ${rundir}"
  # Restart supervisor. The dashboard exits 42 to REQUEST a relaunch — that's the
  # in-browser "Restart" button, so updated code takes effect without you having
  # to come back to this terminal. Any other exit (0 = the "Shut down" button or a
  # normal stop, 130 = Ctrl-C) ends the loop and returns you to the shell.
  local _stop=0; trap '_stop=1' INT TERM
  local rc=0
  while :; do
    # `|| rc=$?` keeps the non-zero exit "tested" so `set -e` does NOT abort the
    # script here — the whole restart mechanism depends on us seeing rc, not dying
    # on it. Exit 42 = relaunch (the browser "Restart" button); any other code ends
    # the loop (0 = "Shut down"/normal stop, 130 = Ctrl-C).
    rc=0
    "${runcmd[@]}" || rc=$?
    if [[ ${rc} -eq 42 && ${_stop} -eq 0 ]]; then
      printf '\n  ↻ Restarting the dashboard (requested from your browser)…\n'
      # Wait for the port to become bindable before relaunching, instead of
      # relaunching straight into it. The outgoing process has exited by now, but
      # the socket it was listening on is not always immediately re-bindable — the
      # rules differ between Linux and the BSD stack macOS uses, and a browser that
      # was mid-request leaves connections behind. Losing that race exited the
      # server with a bare "address already in use" and ended this loop, which from
      # the browser side is indistinguishable from a hang: the page waits forever
      # for a dashboard that no longer exists.
      if ! _dashboard_wait_port_free "${port}" 30; then
        local _owner; _owner="$(_dashboard_port_owner "${port}")"
        warn "port ${port} did not become free within 30s${_owner:+ — still held by ${_owner}}."
        info "  Not relaunching: it would fail to bind. The browser tab will report this."
        rc=1
        break
      fi
      printf '\n'
      continue
    fi
    break
  done
  # The banner above is printed before the server binds, so if the bind lost a
  # race with another process the user has just been told to open a URL that will
  # never answer. The pre-flight makes this rare, not impossible — say plainly
  # that it did not start, rather than leaving uvicorn's bare errno as the last
  # word under an invitation to open the page.
  if [[ ${rc} -ne 0 && ${rc} -ne 130 && ${_stop} -eq 0 ]] && ! _dashboard_port_free "${port}"; then
    local _owner; _owner="$(_dashboard_port_owner "${port}")"
    warn "The dashboard did NOT start — port ${port} was taken${_owner:+ by ${_owner}} before it could bind."
    info "  The URL printed above will not respond. Retry, or use another port:"
    info "    bin/bdtools dashboard --port 8081"
  fi
  exit ${rc}
}

cmd_check_updates() { "${KT_BIN_DIR}/check-updates.sh" "${1:-all}"; }

# Which analysis package versions are actually in use, per tool, and whether the
# channel has newer ones. Separate from `status` (which reports GUI checkouts)
# because "what produced this report?" is a question about the science packages.
cmd_versions() { _need_python; "${PYBIN}" "${KT_BIN_DIR}/lib/packages.py" "$@"; }

cmd_update_packages() { "${KT_BIN_DIR}/update-packages.sh" "$@"; }

cmd_update() {
  # `update --help` used to reach the manifest lookup and report
  # "no tool named '--help'", which reads like the user's mistake rather than a
  # missing help path.
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
usage: bdtools update <tool|all> [--dry-run] [--force]

Move a tool's checkout to the newest upstream release tag and rebuild it, then
bump that tool's pin in tools.yml. Report without changing anything:

  bdtools check-updates [tool|all]

--dry-run  print what would change, touch nothing
--force    rebuild even if already on the newest tag

Only bdtools-owned checkouts are updated. A server tree (e.g. one installed with
`install --server`) is refused, because it may carry reviewed site commits that a
force checkout would discard — reconcile those deliberately, then re-run
`install --server`.
EOF
    return 0
  fi
  [[ $# -ge 1 ]] || die "usage: bdtools update <tool|all> [--dry-run]  (see: bdtools update --help)"
  "${KT_BIN_DIR}/check-updates.sh" --apply "$@"
}

# Put a tool's conda env back to the exact set of packages recorded before the
# last change to it. The snapshot is written by every operation that touches an
# env (see common.sh:snapshot_env), which is the point: a rollback is not a
# restore, and after a failed transaction there was previously no record at all
# of what the env used to contain.
cmd_restore_env() {
  if [[ $# -lt 1 || "${1}" == "-h" || "${1}" == "--help" ]]; then
    cat <<'EOF'
usage: bdtools restore-env <tool> [--prev] [--dry-run]

Reinstall exactly the packages recorded in this tool's env snapshot, taken
before the last operation that modified the env. No solve, no channel lookup:
the snapshot is a resolved package list.

--prev     use the generation before that (the snapshot has one backup)
--dry-run  print the conda command, change nothing

Afterwards, re-run `bdtools install <tool>` if the tool also needs its pip
requirements or frontend rebuilt — those are not part of a conda snapshot.
EOF
    return 0
  fi
  "${KT_BIN_DIR}/restore-env.sh" "$@"
}

cmd_site_init() { "${KT_BIN_DIR}/site-init.sh" "$@"; }

cmd_setup_databases() { "${KT_BIN_DIR}/setup-databases.sh" "$@"; }

cmd_doctor() { "${KT_BIN_DIR}/doctor.sh" "$@"; }

cmd_lint() { "${KT_BIN_DIR}/lint.sh" "$@"; }

cmd_make_launcher() { "${KT_BIN_DIR}/make-launcher.sh" "$@"; }

cmd_test() {
  [[ $# -ge 1 ]] || die "usage: bdtools test <tool|all> [--record] [--keep]"
  "${KT_BIN_DIR}/test.sh" "$@"
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 0; }
  local cmd="$1"; shift
  case "$cmd" in
    list)               cmd_list "$@";;
    status)             cmd_status "$@";;
    install)            cmd_install "$@";;
    local)              cmd_local "$@";;
    dashboard)          cmd_dashboard "$@";;
    make-launcher)      cmd_make_launcher "$@";;
    check-updates)      cmd_check_updates "$@";;
    versions)           cmd_versions "$@";;
    update-packages)    cmd_update_packages "$@";;
    update)             cmd_update "$@";;
    restore-env)        cmd_restore_env "$@";;
    site-init)          cmd_site_init "$@";;
    setup-databases)    cmd_setup_databases "$@";;
    doctor)             cmd_doctor "$@";;
    lint)               cmd_lint "$@";;
    test)               cmd_test "$@";;
    -h|--help|help)     usage;;
    *) die "unknown command: ${cmd} (see: bdtools --help)";;
  esac
}
main "$@"
